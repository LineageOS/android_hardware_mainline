rust_bindgen {
    name: "libimapper_stablec_bindgen",
    crate_name: "imapper_stablec_bindgen",
    wrapper_src: "imapper_stablec_wrapper.hpp",
    source_stem: "bindings",
    bindgen_flags: [
        "--default-enum-style=rust",
        "--ctypes-prefix=std::ffi",
        "--allowlist-type=AIMapper",
    ],
    shared_libs: [
        "libcutils",
    ],
    header_libs: [
        "libarect_headers",
        "libimapper_stablec",
    ],
    vendor_available: true,
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
    visibility: [
        "//external/hbm",
    ],
}
